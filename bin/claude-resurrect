#!/usr/bin/env node
/**
 * claude-resurrect — bring back your Claude Code sessions after a reboot or crash.
 *
 * How it works:
 *   - `snapshot` (run every 30s by a LaunchAgent) copies Claude Code's live
 *     session registry (~/.claude/sessions/*.json) AND Ghostty's window/split
 *     layout (via AppleScript) into a state file, stamped with the current
 *     boot time. Each Ghostty pane is matched to the Claude session running
 *     in it (by title, then by working directory).
 *   - After a reboot, the first snapshot tick notices the boot time changed
 *     and preserves the pre-crash state as pending-restore.json before
 *     overwriting anything.
 *   - `restore` rebuilds each window that held Claude sessions — recreating
 *     its splits (heuristic 2-column grid, not exact geometry), resuming
 *     `claude --resume <session-id>` in matched panes and plain shells in the
 *     rest. Sessions that weren't in any pane get their own window.
 *
 * Sessions that exit gracefully while the machine is up disappear from the
 * live registry and are pruned on the next tick, so they are never resurrected.
 *
 * Stale-registry hardening: a registry entry only counts as live if its pid is
 * alive AND still running a claude process (pids get reused after crashes and
 * reboots). And restore only resumes sessions that have a conversation
 * transcript on disk — anything else would just open a window for
 * `claude --resume` to fail in.
 */

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync, execSync } = require("child_process");

const HOME = os.homedir();
const CLAUDE_SESSIONS_DIR =
  process.env.CLAUDE_RESURRECT_SESSIONS_DIR || path.join(HOME, ".claude", "sessions");
const CLAUDE_PROJECTS_DIR = path.join(HOME, ".claude", "projects");
const STATE_DIR =
  process.env.CLAUDE_RESURRECT_STATE_DIR || path.join(HOME, ".local", "state", "claude-resurrect");
const CURRENT = path.join(STATE_DIR, "current.json");
const PENDING = path.join(STATE_DIR, "pending-restore.json");
const ARCHIVE_DIR = path.join(STATE_DIR, "archive");
const DAEMON_LINK = path.join(STATE_DIR, "bin", "claude-resurrectd");
const PLIST_LABEL = "com.claude-resurrect.snapshot";
const PLIST_PATH = path.join(HOME, "Library", "LaunchAgents", `${PLIST_LABEL}.plist`);
const SNAPSHOT_INTERVAL_SECONDS = 30;

// ---------------------------------------------------------------- utilities

function bootTime() {
  const out = execSync("sysctl -n kern.boottime", { encoding: "utf8" });
  const m = out.match(/sec\s*=\s*(\d+)/);
  if (!m) throw new Error(`could not parse kern.boottime: ${out}`);
  return Number(m[1]);
}

/**
 * Stable per-boot identity. kern.boottime is NOT stable — macOS adjusts it
 * on sleep/wake clock sync, which made "boot changed" fire spuriously.
 */
function bootId() {
  try {
    const id = execSync("sysctl -n kern.bootsessionuuid", { encoding: "utf8" }).trim();
    if (id) return id;
  } catch {}
  return String(deps.bootTime());
}

function pidAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    return err.code === "EPERM"; // alive but not ours
  }
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

function writeJsonAtomic(file, data) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2));
  fs.renameSync(tmp, file);
}

function asQuoted(s) {
  return `"${String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
}

function osascript(script) {
  return execFileSync("osascript", ["-e", script], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 15000,
  });
}

function relTimeName(ms) {
  return ms ? new Date(ms).toISOString() : "?";
}

function shortCwd(cwd) {
  return cwd && cwd.startsWith(HOME) ? "~" + cwd.slice(HOME.length) : cwd || "?";
}

// ------------------------------------------------------- claude live registry

/** The command line running at a pid, or null. Real impl of deps.pidCommand. */
function pidCommand(pid) {
  try {
    const out = execSync(`ps -o command= -p ${pid}`, { encoding: "utf8" }).trim();
    return out || null;
  } catch {
    return null;
  }
}

/**
 * Does a resumable conversation transcript exist for this session?
 * Claude Code writes one per session at ~/.claude/projects/<munged-cwd>/<id>.jsonl;
 * the cwd munging is claude's business, so scan every project dir instead of
 * trying to reproduce it. Real impl of deps.hasConversation.
 */
function hasConversation(sessionId) {
  let dirs;
  try {
    dirs = fs.readdirSync(CLAUDE_PROJECTS_DIR);
  } catch {
    return false;
  }
  return dirs.some((d) => fs.existsSync(path.join(CLAUDE_PROJECTS_DIR, d, `${sessionId}.jsonl`)));
}

/** Read Claude Code's live registry: one JSON file per running process. */
function liveSessions() {
  let files;
  try {
    files = fs.readdirSync(CLAUDE_SESSIONS_DIR).filter((f) => f.endsWith(".json"));
  } catch {
    return [];
  }
  const sessions = [];
  for (const f of files) {
    const s = readJson(path.join(CLAUDE_SESSIONS_DIR, f));
    if (!s || !s.sessionId || !s.pid) continue;
    if (!pidAlive(s.pid)) continue;
    // pid liveness alone is a trap: registry files from crashed sessions
    // survive reboots, and their pids get reused by unrelated processes
    // (EPERM from a system daemon also passes pidAlive). Only trust the pid
    // if it still runs something claude-shaped; no readable command for an
    // "alive" pid is exactly the pid-reuse case, so that counts as dead too.
    const cmd = deps.pidCommand(s.pid);
    if (!cmd || !cmd.includes("claude")) continue;
    sessions.push({
      sessionId: s.sessionId,
      pid: s.pid,
      cwd: s.cwd,
      kind: s.kind || "interactive",
      name: s.name || s.sessionId.slice(0, 8),
      status: s.status || "unknown",
      startedAt: s.startedAt,
    });
  }
  return sessions;
}

// ------------------------------------------------------------- ghostty layout

/**
 * Dump Ghostty's window -> tab -> terminal tree via AppleScript.
 * tty/pid properties exist in newer Ghostty builds; guarded so 1.3.x works.
 * Returns null if Ghostty isn't running or scripting is unavailable.
 */
function captureGhosttyLayout() {
  // NB: inside the tell block, bare `tab` resolves to Ghostty's tab *class*,
  // not the tab character — hence the d variable defined outside it.
  // The `is running` check must stay outside the tell block: telling a
  // non-running app launches it, and a login-time tick must never do that.
  const script = `
set d to character id 9
set out to ""
if application "Ghostty" is running then
  tell application "Ghostty"
    repeat with w in windows
      set out to out & "W" & d & (id of w) & linefeed
      repeat with tb in tabs of w
        set out to out & "T" & d & ((index of tb) as text) & linefeed
        repeat with t in terminals of tb
          set cwdStr to ""
          set titleStr to ""
          set ttyStr to ""
          try
            set cwdStr to (working directory of t) as text
          end try
          try
            set titleStr to (name of t) as text
          end try
          try
            set ttyStr to (tty of t) as text
          end try
          set out to out & "P" & d & cwdStr & d & titleStr & d & ttyStr & linefeed
        end repeat
      end repeat
    end repeat
  end tell
end if
return out`;
  let raw;
  try {
    raw = osascript(script);
  } catch (e) {
    const msg = (e.stderr && String(e.stderr).trim()) || e.message;
    console.error(`[${new Date().toISOString()}] layout capture failed: ${msg}`);
    return null;
  }
  const windows = [];
  let win = null, tab = null;
  for (const line of raw.split("\n")) {
    const [type, ...cols] = line.split("\t");
    if (type === "W") {
      win = { windowId: cols[0], tabs: [] };
      windows.push(win);
      tab = null;
    } else if (type === "T" && win) {
      tab = { index: Number(cols[0]) || 1, panes: [] };
      win.tabs.push(tab);
    } else if (type === "P" && tab) {
      tab.panes.push({ cwd: cols[0] || null, title: cols[1] || null, tty: cols[2] || null, sessionId: null });
    }
  }
  return windows.length > 0 ? windows : null;
}

/** ttys for a claude pid, e.g. "ttys004" -> "/dev/ttys004". */
function ttyOfPid(pid) {
  try {
    const t = execSync(`ps -o tty= -p ${pid}`, { encoding: "utf8" }).trim();
    return t && t !== "??" ? `/dev/${t}` : null;
  } catch {
    return null;
  }
}

/**
 * Match sessions to panes, most precise signal first:
 *   1. tty (exact — needs Ghostty > 1.3 to expose it; guarded)
 *   2. terminal title === session name (claude sets titles for named sessions)
 *   3. same cwd (arbitrary within identical-cwd groups — visually equivalent)
 * Mutates panes (sets sessionId).
 */
function matchSessionsToPanes(layout, sessions) {
  const panes = layout.flatMap((w) => w.tabs.flatMap((t) => t.panes));
  const unclaimed = new Set(sessions);

  const claim = (pane, session) => {
    pane.sessionId = session.sessionId;
    unclaimed.delete(session);
  };

  // pass 1: tty
  for (const s of unclaimed) {
    const tty = ttyOfPid(s.pid);
    if (!tty) continue;
    const pane = panes.find((p) => !p.sessionId && p.tty === tty);
    if (pane) claim(pane, s);
  }
  // pass 2: unique title match
  for (const s of [...unclaimed]) {
    const hits = panes.filter((p) => !p.sessionId && p.title === s.name);
    if (hits.length === 1) claim(hits[0], s);
  }
  // pass 3: cwd (in order)
  for (const s of [...unclaimed]) {
    const pane = panes.find((p) => !p.sessionId && p.cwd === s.cwd);
    if (pane) claim(pane, s);
  }
}

// ---------------------------------------------------------- injectable deps

// Environment probes and effects, indirected so tests can replace them.
// (openWindow is declared below in the restore section; hoisting makes it
// visible here.)
const deps = { bootId, bootTime, liveSessions, captureGhosttyLayout, pidCommand, hasConversation, openWindow };

// ------------------------------------------------------------------ snapshot

function snapshot() {
  const boot = deps.bootId();
  const bootT = deps.bootTime();
  const prev = readJson(CURRENT);
  // pre-bootId snapshots only carry bootTime — compare what's available
  const bootChanged = prev
    ? prev.bootId
      ? prev.bootId !== boot
      : prev.bootTime !== bootT
    : false;

  // A snapshot from a previous boot means the machine went down while those
  // sessions were running. Preserve it before we overwrite.
  if (prev && bootChanged && (prev.sessions || []).length > 0) {
    writeJsonAtomic(PENDING, prev);
    fs.mkdirSync(ARCHIVE_DIR, { recursive: true });
    writeJsonAtomic(path.join(ARCHIVE_DIR, `${prev.savedAt || "unknown"}.json`), prev);
  }

  const sessions = deps.liveSessions();
  let layout = deps.captureGhosttyLayout();
  let layoutStale = false;
  if (layout) {
    matchSessionsToPanes(layout, sessions);
  } else if (prev && !bootChanged && prev.layout) {
    // Transient capture failure (AppleScript hiccup, permission blip): keep
    // the last-known pane structure instead of destroying it, and re-match
    // the currently-live sessions onto it.
    layout = JSON.parse(JSON.stringify(prev.layout));
    for (const w of layout) for (const t of w.tabs) for (const p of t.panes) p.sessionId = null;
    matchSessionsToPanes(layout, sessions);
    layoutStale = true;
  }

  writeJsonAtomic(CURRENT, {
    bootId: boot,
    bootTime: bootT,
    savedAt: new Date().toISOString().replace(/[:.]/g, "-"),
    sessions,
    layout,
    layoutStale,
  });
}

// ---------------------------------------------------------------------- list

function loadRestorable() {
  const pending = readJson(PENDING);
  if (pending) return { source: "pending", data: pending };
  const current = readJson(CURRENT);
  if (current) return { source: "current", data: current };
  return null;
}

function list() {
  const loaded = loadRestorable();
  if (!loaded) {
    console.log("No snapshot yet. Run `claude-resurrect install` to start the snapshotter.");
    return;
  }
  const { source, data } = loaded;
  const live = new Set(deps.liveSessions().map((s) => s.sessionId));
  const label = source === "pending" ? "pending restore (saved before last shutdown/crash)" : "latest snapshot";
  console.log(`Sessions in ${label}:\n`);
  const paneOf = new Map();
  (data.layout || []).forEach((w, wi) =>
    w.tabs.forEach((t) => t.panes.forEach((p) => { if (p.sessionId) paneOf.set(p.sessionId, `win ${wi + 1}`); }))
  );
  for (const s of data.sessions || []) {
    const state = live.has(s.sessionId) ? "running" : "dead";
    const kind = s.kind === "bg" ? "bg " : "int";
    const where = paneOf.get(s.sessionId) || "-";
    console.log(`  [${state.padEnd(7)}] ${kind} ${s.name.padEnd(28)} ${where.padEnd(7)} ${shortCwd(s.cwd)}`);
  }
  if (data.layout) {
    const winCount = data.layout.length;
    const paneCount = data.layout.reduce((n, w) => n + w.tabs.reduce((m, t) => m + t.panes.length, 0), 0);
    const stale = data.layoutStale ? " (stale — from the last successful capture)" : "";
    console.log(`\nLayout: ${winCount} window(s), ${paneCount} pane(s) captured${stale}.`);
  } else {
    console.log("\nLayout: not captured (Ghostty scripting unavailable at snapshot time).");
  }
  if (source === "pending") {
    console.log(`Run \`claude-resurrect restore\` to bring it all back.`);
  }
}

// ------------------------------------------------------------------- restore

function paneDir(cwd) {
  return cwd && fs.existsSync(cwd) ? cwd : HOME;
}

/**
 * Split arrangement for N panes: entry i says how pane i+1 splits off —
 * {target: <pane index>, direction: "right"|"down"}. Ghostty 1.3.1's
 * AppleScript dictionary exposes no terminal position/size (checked
 * Ghostty.sdef), so original geometry can't be captured; the arrangement is
 * a heuristic, and the style lets users pick the shape they actually work in:
 *   grid    — 2-column grid: pane 1 right of pane 0, pane i down from pane i-2
 *   columns — every pane right of the previous one
 *   rows    — every pane down from the previous one
 */
const LAYOUT_STYLES = ["grid", "columns", "rows"];
function splitPlan(count, style) {
  const plan = [];
  for (let i = 1; i < count; i++) {
    if (style === "columns") plan.push({ target: i - 1, direction: "right" });
    else if (style === "rows") plan.push({ target: i - 1, direction: "down" });
    else if (i === 1) plan.push({ target: 0, direction: "right" });
    else plan.push({ target: i - 2, direction: "down" });
  }
  return plan;
}

/**
 * Rebuild one window with N panes arranged per splitPlan(style).
 * Types `claude --resume` into panes that had sessions.
 */
function buildWindow(panes, style) {
  const lines = [`tell application "Ghostty"`, `  activate`];
  panes.forEach((p, i) => {
    lines.push(`  set cfg${i} to new surface configuration`);
    lines.push(`  set initial working directory of cfg${i} to ${asQuoted(paneDir(p.cwd))}`);
  });
  lines.push(`  set win to new window with configuration cfg0`);
  lines.push(`  delay 0.5`);
  lines.push(`  set t0 to terminal 1 of tab 1 of win`);
  splitPlan(panes.length, style).forEach(({ target, direction }, idx) => {
    lines.push(`  set t${idx + 1} to split t${target} direction ${direction} with configuration cfg${idx + 1}`);
    lines.push(`  delay 0.3`);
  });
  lines.push(`  delay 0.6`);
  panes.forEach((p, i) => {
    if (!p.resumeId) return;
    lines.push(`  input text ${asQuoted(resumeCommand(p))} to t${i}`);
    lines.push(`  send key "enter" to t${i}`);
  });
  lines.push(`end tell`);
  osascript(lines.join("\n"));
}

/**
 * The typed shell command: retitle the pane to the session's name first
 * (otherwise Ghostty titles the window "claude --resume <uuid>"), then resume.
 * Escaping: asQuoted() doubles backslashes for AppleScript, so the shell
 * receives the literal printf sequences \\033 / \\007.
 */
function resumeCommand(p) {
  const title = String(p.resumeName || "claude").replace(/'/g, `'\\''`);
  return `printf '\\033]0;%s\\007' '${title}'; claude --resume ${p.resumeId}`;
}

/** Fallback: one Ghostty instance per window; window closes when claude exits. */
function openViaOpen(cwd, sessionId) {
  execFileSync("open", [
    "-na", "Ghostty.app", "--args",
    `--working-directory=${paneDir(cwd)}`,
    "--quit-after-last-window-closed=true",
    "-e", "claude", "--resume", sessionId,
  ]);
}

let appleScriptBroken = false;
function openWindow(panes, style) {
  if (!appleScriptBroken) {
    try {
      buildWindow(panes, style);
      return;
    } catch (e) {
      appleScriptBroken = true;
      console.error(`  (AppleScript failed — falling back to \`open -n\`, sessions only, no splits: ${e.stderr?.toString().trim() || e.message})`);
    }
  }
  for (const p of panes) {
    if (p.resumeId) openViaOpen(p.cwd, p.resumeId);
  }
}

/**
 * Split style for this restore run: --layout <style> wins, then the
 * CLAUDE_RESURRECT_LAYOUT env var (read here, at restore time, so tests and
 * shells that set it after module load still take effect), then "grid".
 * Unknown styles warn and fall back — a bad flag must never abort a
 * crash-recovery run.
 */
function layoutStyle(args) {
  const flagIdx = args.indexOf("--layout");
  const requested =
    (flagIdx !== -1 && args[flagIdx + 1]) || process.env.CLAUDE_RESURRECT_LAYOUT || "grid";
  if (LAYOUT_STYLES.includes(requested)) return requested;
  console.log(`Warning: unknown layout style "${requested}" — using "grid" (valid: ${LAYOUT_STYLES.join(", ")}).`);
  return "grid";
}

async function restore(args) {
  const dryRun = args.includes("--dry-run");
  const includeBg = args.includes("--include-bg");
  const style = layoutStyle(args);

  const loaded = loadRestorable();
  if (!loaded) {
    console.log("Nothing to restore: no snapshot found.");
    console.log("Run `claude-resurrect install` so sessions get snapshotted from now on.");
    return;
  }
  const { source, data } = loaded;
  if (source === "current") {
    console.log("Note: no pending-restore snapshot from a previous boot; using the latest live snapshot.");
  }

  const live = new Set(deps.liveSessions().map((s) => s.sessionId));
  const all = data.sessions || [];
  const bySessionId = new Map(all.map((s) => [s.sessionId, s]));
  const dead = (id) => bySessionId.has(id) && !live.has(id);
  // Dead sessions with no conversation transcript on disk can't be resumed —
  // `claude --resume` would just fail with "No conversation found". Skip them
  // everywhere (panes and strays) instead of opening ghost windows.
  const noTranscript = all.filter((s) => dead(s.sessionId) && !deps.hasConversation(s.sessionId));
  const ghosts = new Set(noTranscript.map((s) => s.sessionId));
  const resumable = (id) => dead(id) && !ghosts.has(id);
  const placed = new Set(); // session ids restored (or skipped) via layout

  if (!data.layout) {
    console.log("Warning: this snapshot has no window layout (Ghostty wasn't scriptable when it was taken) — falling back to one window per session, no splits.");
  } else if (data.layoutStale) {
    console.log("Note: layout is from the last successful capture before the machine went down; pane arrangement may be slightly out of date.");
  }

  let opened = 0;

  // --- layout-aware pass: rebuild windows that held at least one dead session
  for (const win of data.layout || []) {
    // extra tabs are treated as their own windows (tab creation isn't
    // reliably scriptable yet); each tab's panes become one window
    for (const tab of win.tabs) {
      for (const p of tab.panes) if (p.sessionId) placed.add(p.sessionId);
      const deadHere = tab.panes.filter((p) => p.sessionId && resumable(p.sessionId));
      if (deadHere.length === 0) continue;
      // rebuild the tab's panes; skip panes whose session still runs, and
      // panes whose dead session has no transcript to resume
      const panes = tab.panes
        .filter((p) => !p.sessionId || resumable(p.sessionId))
        .map((p) => {
          const resuming = p.sessionId && resumable(p.sessionId);
          // Resuming panes must start in the SESSION's cwd, not the pane's:
          // Ghostty reports the shell's launch dir, not the claude process's
          // cwd (a worktree agent launched from the repo root reports the
          // root). Resuming in the wrong dir re-homes the session under the
          // wrong project and duplicates worktree agents.
          const session = resuming ? bySessionId.get(p.sessionId) : null;
          return {
            cwd: (session && session.cwd) || p.cwd,
            resumeId: resuming ? p.sessionId : null,
            resumeName: resuming ? session.name : null,
          };
        });
      const desc = panes
        .map((p) => (p.resumeId ? bySessionId.get(p.resumeId).name : "shell"))
        .join(" | ");
      console.log(`${dryRun ? "[dry-run] would rebuild" : "rebuilding"} window: [ ${desc} ]  (${panes.length} pane${panes.length > 1 ? "s" : ""})`);
      if (!dryRun) {
        deps.openWindow(panes, style);
        opened++;
        await new Promise((r) => setTimeout(r, 500));
      }
    }
  }

  // --- windowless pass: dead sessions that weren't in any captured pane
  const strays = all.filter((s) => !placed.has(s.sessionId) && resumable(s.sessionId));
  const strayTargets = strays.filter((s) => s.kind === "interactive" || includeBg);
  const bgSkipped = strays.filter((s) => s.kind === "bg" && !includeBg);

  for (const s of strayTargets) {
    console.log(`${dryRun ? "[dry-run] would open" : "opening"}  ${s.name.padEnd(28)} ${shortCwd(s.cwd)}`);
    if (!dryRun) {
      deps.openWindow([{ cwd: s.cwd, resumeId: s.sessionId, resumeName: s.name }], style);
      opened++;
      await new Promise((r) => setTimeout(r, 500));
    }
  }

  if (opened === 0 && strayTargets.length === 0 && !dryRun) {
    console.log(all.some((s) => !live.has(s.sessionId))
      ? "Nothing eligible to restore."
      : "All snapshotted sessions are already running — nothing to do.");
  }

  if (noTranscript.length > 0) {
    console.log(`\nNOTE: ${noTranscript.length} session(s) skipped — no conversation transcript on disk, so \`claude --resume\` has nothing to load:`);
    for (const s of noTranscript) {
      console.log(`  ${s.name.padEnd(28)} ${s.sessionId.slice(0, 8)}`);
    }
  }

  if (bgSkipped.length > 0) {
    console.log(`\nNOTE: ${bgSkipped.length} background agent(s) were running but are NOT reopened automatically.`);
    console.log(`View them with \`claude agents\`, rerun with --include-bg, or resume individually:`);
    for (const s of bgSkipped) {
      console.log(`  ${s.name.padEnd(28)} claude --resume ${s.sessionId}`);
    }
  }

  if (!dryRun && source === "pending") {
    fs.rmSync(PENDING, { force: true });
    console.log(`\nDone. Pending snapshot consumed (archived in ${ARCHIVE_DIR}).`);
  }
}

// ------------------------------------------------------------ install/uninstall

/**
 * The LaunchAgent runs node through a symlink named `claude-resurrectd` so the
 * background process shows up as "claude-resurrectd" (not "node") in ps,
 * Activity Monitor, and System Settings > Login Items.
 */
function ensureDaemonLink() {
  // prefer homebrew's stable symlink over the versioned Cellar path so node
  // upgrades don't break the agent
  const brewNode = "/opt/homebrew/bin/node";
  const nodeBin = fs.existsSync(brewNode) ? brewNode : process.execPath;
  fs.mkdirSync(path.dirname(DAEMON_LINK), { recursive: true });
  fs.rmSync(DAEMON_LINK, { force: true });
  fs.symlinkSync(nodeBin, DAEMON_LINK);
  return DAEMON_LINK;
}

function plistXml() {
  const daemon = ensureDaemonLink();
  const self = fs.realpathSync(__filename);
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${daemon}</string>
    <string>${self}</string>
    <string>snapshot</string>
  </array>
  <key>StartInterval</key><integer>${SNAPSHOT_INTERVAL_SECONDS}</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>${path.join(STATE_DIR, "snapshot.err.log")}</string>
</dict>
</plist>
`;
}

function install() {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  fs.mkdirSync(path.dirname(PLIST_PATH), { recursive: true });
  fs.writeFileSync(PLIST_PATH, plistXml());
  const domain = `gui/${process.getuid()}`;
  try {
    execSync(`launchctl bootout ${domain}/${PLIST_LABEL} 2>/dev/null`);
  } catch {} // not loaded yet — fine
  execSync(`launchctl bootstrap ${domain} ${JSON.stringify(PLIST_PATH)}`);
  snapshot();
  console.log(`Installed. Snapshotting every ${SNAPSHOT_INTERVAL_SECONDS}s via LaunchAgent:\n  ${PLIST_PATH}`);
  console.log(`Background process name: claude-resurrectd`);
  console.log(`State lives in ${STATE_DIR}`);
  console.log(`After a reboot, run: claude-resurrect restore`);
}

function uninstall() {
  const domain = `gui/${process.getuid()}`;
  try {
    execSync(`launchctl bootout ${domain}/${PLIST_LABEL} 2>/dev/null`);
  } catch {}
  fs.rmSync(PLIST_PATH, { force: true });
  console.log("Uninstalled LaunchAgent. State files left in place:");
  console.log(`  ${STATE_DIR}`);
}

// ---------------------------------------------------------------------- main

if (require.main !== module) {
  // test/embedding interface — CLI dispatch below is skipped
  module.exports = { snapshot, restore, splitPlan, deps };
  return;
}

const [cmd, ...rest] = process.argv.slice(2);
const commands = { snapshot, list, install, uninstall };

if (cmd === "restore") {
  restore(rest).catch((e) => { console.error(e.message); process.exit(1); });
} else if (commands[cmd]) {
  try {
    commands[cmd]();
  } catch (e) {
    console.error(e.message);
    process.exit(1);
  }
} else {
  console.log(`claude-resurrect — restore Claude Code sessions in Ghostty after a reboot

usage:
  claude-resurrect install     set up the background snapshotter (LaunchAgent)
  claude-resurrect restore     rebuild windows/splits and resume dead sessions
       --dry-run               show what would be reopened without doing it
       --include-bg            also reopen stray background agents as windows
       --layout <style>        split arrangement: grid | columns | rows
                               (default: $CLAUDE_RESURRECT_LAYOUT, else grid)
  claude-resurrect list        show the sessions + layout in the latest snapshot
  claude-resurrect snapshot    take one snapshot now (the LaunchAgent runs this)
  claude-resurrect uninstall   remove the LaunchAgent`);
}
